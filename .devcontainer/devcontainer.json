{
    // following instructions from https://verl.readthedocs.io/en/latest/start/install.html
    "name": "Multiturn RL Devcontainer",
    "image": "verlai/verl:app-verl0.5-vllm0.9.1-mcore0.12.2-te2.2",
    "workspaceFolder": "/workspace/verl",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace/verl,type=bind",
        "source=${env:HOME}/.cache/huggingface,target=/root/.cache/huggingface,type=bind",
        "source=${env:HOME}/.gitconfig,target=/root/.gitconfig,type=bind",
        "source=${env:SSH_AUTH_SOCK},target=/ssh-agent,type=bind,consistency=cached"
    ],
    "runArgs": [
        "--gpus",
        "all",
        "--net",
        "host",
        "--shm-size",
        "10g",
        "--cap-add",
        "SYS_ADMIN",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock" // mount host docker socket for DiD
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                "charliermarsh.ruff"
            ],
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            }
        }
    },
    "remoteUser": "root",
    "shutdownAction": "stopContainer",
    // TODO: bake the docker install into the image
    "postCreateCommand": "pip install -e . --no-deps && apt-get update && apt-get install -y docker.io && pip install docker \"mcp[cli]\"",
    "remoteEnv": {}
}